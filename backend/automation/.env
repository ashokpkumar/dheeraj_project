# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=automation.settings

# Orchestrator Mode
# Set to True to run scheduler and manage jobs
# Set to False to run as worker-only instance
IS_ORCHESTRATOR=True

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Flower (Celery UI)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:password

# Gunicorn Settings
WORKERS=4
WORKER_TIMEOUT=60

WINDOWS_SERVICE_HOST=192.168.1.100
WINDOWS_SERVICE_PORT=5555
WINDOWS_SERVICE_TIMEOUT=300