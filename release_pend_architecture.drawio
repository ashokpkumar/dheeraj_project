<mxfile host="app.diagrams.net">
  <diagram id="rp-functional" name="Functional Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" parent="1" value="release_pend_run_batch — Functional Flow (What it does in the emulator)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1">
          <mxGeometry x="100" y="12" width="1500" height="40" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="leg_bg" parent="1" value="" style="rounded=0;fillColor=#f5f5f5;strokeColor=#aaaaaa;" vertex="1">
