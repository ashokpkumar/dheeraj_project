    <!-- ======================================================= -->
    <mxCell id="R_tod_bg" value="TOD MODULE  (tod.py)" style="swimlane;startSize=28;fillColor=#e0f2f1;strokeColor=#00695c;fontColor=#004d40;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="2620" y="1405" width="830" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="Tod1" value="check_tod(row)&#xa;my_tod = row[TOD].strip()&#xa;❶ not empty&#xa;❷ isdigit()&#xa;❸ len(my_tod) ≤ 2&#xa;Returns bool" style="rounded=1;fillColor=#00695c;strokeColor=#004d40;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="2635" y="1445" width="185" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="Tod2" value="tod_update(screen, row, settings)&#xa;① call check_tod(row)&#xa;  → fail: row[MACRO_STATUS]=CHECK TOD VALUE, return False&#xa;② Navigate CPS520.01 (pf9 loop)&#xa;③ Enter claim_no → go to draft 01&#xa;④ send_enter → condition select screen (CPS520.01)&#xa;⑤ Loop condition rows 4-18 step 2:&#xa;   For my_tod in (&#39;99&#39;, &#39;00&#39;):&#xa;     place_value(my_tod, row, col)&#xa;     send_enter() → screen == CPS910.01&#xa;     enter TOD → if still CPS910.01: error&#xa;⑥ Returns True on success" style="rounded=1;fillColor=#00695c;strokeColor=#004d40;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="2835" y="1440" width="340" height="210" as="geometry"/>
    </mxCell>

