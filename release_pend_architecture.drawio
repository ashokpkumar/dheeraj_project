    <!-- UB edit errors -->
    <mxCell id="H8" value="EDIT ERROR checks:&#xa;fieldattr 4c35/4c63==201: clear&#xa;MPIN r24/r22: clear&#xa;CPS445 dup: enter+x r29c78 or DUP return 0&#xa;1432 CALC CHRG: aply_dnl_aft_medcr fix&#xa;FOR BN: place BN_CODE rows 12-15&#xa;8803/8806/8807 loop: set RP, clear PC#&#xa;1237-SP REQUIRED: calc sp_amt&#xa;PRVD OPI P&amp;P: inel 0.00/908&#xa;aply_dx_excptn: E exception loop&#xa;POS/TOS: ub_tos_entry()&#xa;remv_prcrt_byps: RP bypass&#xa;aply_st_typ: BY SAD ERR or ALL LINES&#xa;SURP BILL: } fix&#xa;MULTIPLE PRE-CERTS: place PRE_CERT_NO" style="rounded=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=9;" vertex="1" parent="1">
