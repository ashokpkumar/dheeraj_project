    <mxCell id="Res1" value="Draft loop done:&#xa;row_done=True → DONE.&#xa;row_done=False → final_status msg" style="rounded=1;fillColor=#c8e6c9;strokeColor=#558b2f;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="2635" y="1745" width="230" height="65" as="geometry"/>
