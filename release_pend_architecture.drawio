        <!-- CPS520.01 — initial entry -->
        <mxCell id="scr520_hdr" parent="1" value="SCREEN: CPS520.01   (Claim Search / List)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="555" y="652" width="370" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr520_body" parent="1" value="Place claim_no @ (row 8, col 15)&#xa;Clear field  @ (row 9, col 15)&#xa;Clear field  @ (row 12, col 15)&#xa;→ ENTER" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="555" y="676" width="370" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d_still520" parent="1" value="Still on CPS520.01&#xa;after ENTER?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="758" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="err_520" parent="1" value="Read error msg @ (31,2,70)&#xa;PF9 → SKIP claim" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="1060" y="771" width="260" height="34" as="geometry" />
        </mxCell>

        <!-- ═══════════════ DRAFT LOOP ═══════════════ -->
        <mxCell id="hdr_draft" parent="1" value="FOR EACH DRAFT  (1 .. DRAFTS)   — navigates back to CPS520.01 at the start of every iteration" style="text;html=1;align=left;fontStyle=1;fontSize=11;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontColor=#4a148c;" vertex="1">
          <mxGeometry x="100" y="842" width="1500" height="24" as="geometry" />
        </mxCell>

        <!-- Navigate to CPS520 per draft -->
        <mxCell id="scr520_nav" parent="1" value="SCREEN: CPS520.01   (navigate back — PF9 loop × 10 until on CPS520)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="555" y="876" width="370" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr520_nav_body" parent="1" value="Place claim_no @ (8,15);  clear (9,15) (12,15)  →  ENTER" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="555" y="900" width="370" height="28" as="geometry" />
        </mxCell>

        <!-- Draft selector -->
        <mxCell id="d_lstrls" parent="1" value="lst_rls = Y?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="952" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lstrls_y" parent="1" value="LIST-RELEASE MODE&#xa;Scan rows 6,8,10,12,14,16,18&#xa;Find first where status col ≠ &quot;66&quot;&#xa;Place that row# @ (3,26)  →  ENTER" style="rounded=1;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#212121;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="150" y="942" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lstrls_n" parent="1" value="SEQUENTIAL MODE&#xa;Place selector j @ (3,26)&#xa;j starts at 1, increments each draft&#xa;Resets to 1 at draft 8+  →  ENTER" style="rounded=1;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#212121;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="1060" y="942" width="290" height="70" as="geometry" />
        </mxCell>

        <!-- CPS850.01 block -->
        <mxCell id="d_is850" parent="1" value="Screen =&#xa;CPS850.01?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="1046" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="scr850_hdr" parent="1" value="SCREEN: CPS850.01   (Claim Header — optional fields)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="455" y="1130" width="570" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr850_body" parent="1" value="aply_opi = Y   →  place NEW_OPI @ (22,58);  &quot;x&quot; @ (23,52);  ENTER;  if still 850 → FAIL;  PF8 → &quot;850&quot; @ (2,37) → ENTER (refresh OPI)&#xa;aply_opi = D   →  clear (22,58);  &quot;x&quot; @ (23,52);  ENTER&#xa;aply_850_nt = APPEND / 2ND LINE   →  place_new_csr_note(screen, row)&#xa;chnge_dx_cd = Y   →  DX_CD @ (23,6);  &quot;Y&quot; @ (23,14)&#xa;aply_int_zip = Y   →  &quot;X&quot; @ (29,26) → ENTER → CPS325.01:  ZIP @ (5,69),  INT_NO @ (7,30)  → ENTER&#xa;→ ENTER  (exit CPS850)" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="455" y="1154" width="570" height="112" as="geometry" />
        </mxCell>

        <!-- CPS910.01 -->
        <mxCell id="d_is910" parent="1" value="Screen =&#xa;CPS910.01?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="1294" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="scr910_hdr" parent="1" value="SCREEN: CPS910.01   (TOD Prompt)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="555" y="1376" width="370" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr910_body" parent="1" value="Place TOD value (zero-padded to 2 digits) @ (5,60)&#xa;→ ENTER;   if still on CPS910 → FAIL draft" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="555" y="1400" width="370" height="38" as="geometry" />
        </mxCell>

        <!-- Condition note / AFV -->
        <mxCell id="s_cond" parent="1" value="aply_cond_nt  = Y   →  add_condition_note(screen, row)      fail → FAIL draft&#xa;aply_cond_afv = Y   →  update_condition_afv(screen, row)    fail → FAIL draft" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="455" y="1462" width="570" height="44" as="geometry" />
        </mxCell>

        <!-- CLAIM_TYPE split -->
        <mxCell id="d_clmtype" parent="1" value="CLAIM_TYPE?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="1532" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- UB branch -->
        <mxCell id="ub_hdr" parent="1" value="UB  →  SCREEN: BLX2460.01" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="80" y="1632" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ub_body" parent="1" value="updt_frm_to_dt = Y:&#xa;  Read FROM @ (2,63), THRU @ (2,75), SERV @ (6,17)&#xa;  FROM ≠ SERV  →  clear (2,63), place SERV @ (2,63)&#xa;  THRU ≠ SERV  →  clear (2,75), place SERV @ (2,75)&#xa;&#xa;apply_ineligibility_codes(&quot;UB&quot;, dny_by_cpt ref)&#xa;&#xa;chk_per_diem = Y:&#xa;  ub_per_diem_process()&#xa;  STOP all remaining drafts&#xa;  status → &quot;PER DIEM PROCESSED&quot;&#xa;&#xa;ub_data_entry(screen, row, settings, codes)&#xa;  res = 0  →  FAIL (stop drafts)&#xa;  res = 1  →  draft OK, continue" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="80" y="1656" width="320" height="218" as="geometry" />
        </mxCell>

        <!-- HCFA branch -->
        <mxCell id="hcfa_hdr" parent="1" value="HCFA  →  SCREEN: CPS450.01" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="1080" y="1632" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hcfa_body" parent="1" value="apply_ineligibility_codes(&quot;HCFA&quot;, dny_by_cpt ref)&#xa;&#xa;hcfa_data_entry(screen, row, settings, codes)&#xa;  res = 0  →  FAIL (stop drafts)&#xa;  res = 1  →  draft OK, continue" style="rounded=0;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="1080" y="1656" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- Invalid claim type -->
        <mxCell id="err_clmtype" parent="1" value="Other  →  INVALID CLAIM TYPE  →  FAIL draft" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="555" y="1632" width="370" height="34" as="geometry" />
        </mxCell>

        <!-- Draft result / loop back -->
        <mxCell id="draft_loop" parent="1" value="Draft OK  →  loop back to next draft (↑ CPS520.01 nav)&#xa;Draft FAILED  →  record error status,  PF9,  stop remaining drafts for this claim" style="rounded=1;fillColor=#546e7a;strokeColor=#37474f;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="455" y="1910" width="570" height="44" as="geometry" />
        </mxCell>

        <!-- Claim result -->
        <mxCell id="s_result" parent="1" value="All drafts OK  →  append { CLAIM CONTROL #, MACRO STATUS: &quot;DONE.&quot; }&#xa;Any draft failed  →  append { CLAIM CONTROL #, MACRO STATUS: &lt;error msg&gt; }&#xa;PF9  →  proceed to next claim" style="rounded=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="455" y="1976" width="570" height="54" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" parent="1" value="DONE&#xa;Return { success: true, result: [ list of dicts ] }" style="ellipse;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1">
          <mxGeometry x="590" y="2054" width="300" height="50" as="geometry" />
        </mxCell>

