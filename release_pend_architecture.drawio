    <mxCell id="Res2" value="results.append({&#xa;  CLAIM CONTROL #: claim_no,&#xa;  MACRO STATUS: macro_status&#xa;})" style="rounded=1;fillColor=#c8e6c9;strokeColor=#558b2f;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="2875" y="1745" width="210" height="65" as="geometry"/>
    </mxCell>
    <mxCell id="Res3" value="Exception handling:&#xa;Catches any exception per row&#xa;MACRO STATUS = EXCEPTION: type: msg&#xa;finally: always send_pf(9)" style="rounded=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="3095" y="1745" width="240" height="65" as="geometry"/>
    </mxCell>
    <mxCell id="Res4" value="return {&#34;success&#34;: True, &#34;result&#34;: results}" style="rounded=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="2635" y="1830" width="700" height="60" as="geometry"/>
