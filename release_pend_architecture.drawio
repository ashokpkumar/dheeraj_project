        </mxCell>

        <!-- ═══════════════ SETUP ═══════════════ -->
        <mxCell id="hdr_setup" parent="1" value="SETUP" style="text;html=1;align=left;fontStyle=1;fontSize=11;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;" vertex="1">
          <mxGeometry x="100" y="108" width="1500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" parent="1" value="START" style="ellipse;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1">
          <mxGeometry x="680" y="142" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s_load" parent="1" value="Load DX code refs (dx_code_ref_path CSV)&#xa;Load rule settings (rule_code_ref_path CSV — keyed by RULE value)" style="rounded=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="555" y="202" width="370" height="46" as="geometry" />
        </mxCell>

        <mxCell id="s_connect" parent="1" value="Connect to Emulator&#xa;win32com.client.Dispatch(&quot;EXTRA.System&quot;) → ActiveSession → Screen" style="rounded=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="555" y="268" width="370" height="46" as="geometry" />
        </mxCell>

        <!-- ═══════════════ PER-CLAIM ═══════════════ -->
        <mxCell id="hdr_claim" parent="1" value="FOR EACH CLAIM (CLAIM_NO) IN DATAFRAME" style="text;html=1;align=left;fontStyle=1;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;" vertex="1">
          <mxGeometry x="100" y="334" width="1500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="d_rule" parent="1" value="RULE column value&#xa;found in rule CSV?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="640" y="374" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="skip_rule" parent="1" value="SKIP: 'RULE not found in rule CSV'" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="1060" y="392" width="260" height="34" as="geometry" />
        </mxCell>

        <mxCell id="d_seqord" parent="1" value="seq_ordr=Y  AND&#xa;cert_no = last skipped cert_no?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="625" y="470" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="skip_seq" parent="1" value="PF9 → SKIP: 'SKIPPED (SEQ ORDER)'" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="1060" y="488" width="260" height="34" as="geometry" />
        </mxCell>

        <mxCell id="d_tod" parent="1" value="aply_tod_updt = Y?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="645" y="568" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tod_box" parent="1" value="tod_update(screen, row, settings)&#xa;fail → PF9, SKIP with error msg" style="rounded=1;fillColor=#00695c;strokeColor=#004d40;fontColor=#ffffff;fontSize=10;" vertex="1">
