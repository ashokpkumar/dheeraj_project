        <mxCell id="skip_seq" parent="1" value="send_pf(9) → SKIP: 'SKIPPED (SEQ ORDER)'&#xa;utils.py: send_pf(screen, 9)" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="1110" y="518" width="250" height="34" as="geometry" />
        </mxCell>

        <mxCell id="d_tod" parent="1" value="aply_tod_updt = Y?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
