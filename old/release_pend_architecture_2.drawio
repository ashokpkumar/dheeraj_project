        <mxCell id="d_seqord" parent="1" value="seq_ordr=Y  AND&#xa;cert_no = last skipped cert_no?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
