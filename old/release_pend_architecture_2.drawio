        <mxCell id="scr520_nav" parent="1" value="SCREEN: CPS520.01   (navigate back — send_pf(9) loop × 10 until on CPS520)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
