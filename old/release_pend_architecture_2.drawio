        <!-- ═══════════════ DRAFT LOOP ═══════════════ -->
        <mxCell id="hdr_draft" parent="1" value="FOR EACH DRAFT  (1..DRAFTS)   — loop back to here after each draft   |   all screen nav via utils.py primitives" style="text;html=1;align=left;fontStyle=1;fontSize=11;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontColor=#4a148c;" vertex="1">
