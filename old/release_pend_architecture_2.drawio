        </mxCell>

        <mxCell id="d_lstrls" parent="1" value="lst_rls = Y?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="695" y="1006" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lstrls_y" parent="1" value="LIST-RELEASE MODE (script.py)&#xa;Scan rows 6,8,10,12,14,16,18&#xa;Find first where screen.GetString(row,6,2) ≠ &quot;66&quot;&#xa;place_value(that_row#, 3, 26)  →  send_enter()" style="rounded=1;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#212121;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="170" y="996" width="320" height="78" as="geometry" />
        </mxCell>
        <mxCell id="lstrls_n" parent="1" value="SEQUENTIAL MODE (script.py)&#xa;place_value(j, 3, 26)  [j starts at 1, +1 each draft]&#xa;At draft 8: j=1, send_pf(11) first&#xa;→  send_enter()" style="rounded=1;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#212121;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="1110" y="996" width="310" height="78" as="geometry" />
        </mxCell>

        <!-- CPS850.01 block -->
        <mxCell id="d_is850" parent="1" value="Screen =&#xa;CPS850.01?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="695" y="1110" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="scr850_hdr" parent="1" value="SCREEN: CPS850.01   (Claim Header — optional field updates before data entry)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="420" y="1196" width="720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr850_body" parent="1" value="&lt;b&gt;aply_opi=Y&lt;/b&gt;  →  place_value(NEW_OPI, 22,58);  place_value(&apos;x&apos;, 23,52);  send_enter();  if still 850 → FAIL;  send_pf(8) → place_value(&apos;850&apos;,2,37) → send_enter() (refresh OPI)&lt;br/&gt;&lt;b&gt;aply_opi=D&lt;/b&gt;  →  remove_value(22,58);  place_value(&apos;x&apos;, 23,52);  send_enter()&lt;br/&gt;&lt;b&gt;aply_850_nt = APPEND / 2ND LINE&lt;/b&gt;  →  &lt;font color=&quot;#90caf9&quot;&gt;utils.py: place_new_csr_note(screen, row, opt)&lt;/font&gt;  — navigates to BLX120.01, word-wraps NOTE_850 text&lt;br/&gt;&lt;b&gt;chnge_dx_cd=Y&lt;/b&gt;  →  place_value(DX_CD, 23,6);  place_value(&apos;Y&apos;, 23,14)&lt;br/&gt;&lt;b&gt;aply_int_zip=Y&lt;/b&gt;  →  place_value(&apos;X&apos;, 29,26) → send_enter() → CPS325.01:  place_value(ZIP, 5,69);  place_value(INT_NO, 7,30) → send_enter()&lt;br/&gt;→ send_enter()  (exit CPS850)&lt;br/&gt;&lt;i&gt;All field ops: utils.py place_value / remove_value / send_enter / send_pf&lt;/i&gt;" style="rounded=0;html=1;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="420" y="1220" width="720" height="138" as="geometry" />
        </mxCell>

        <!-- CPS910.01 -->
        <mxCell id="d_is910" parent="1" value="Screen =&#xa;CPS910.01?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="695" y="1384" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="scr910_hdr" parent="1" value="SCREEN: CPS910.01   (TOD Prompt)" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="580" y="1466" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scr910_body" parent="1" value="utils.py: place_value(TOD.zfill(2), 5, 60)  →  send_enter()&lt;br/&gt;if still on CPS910.01 → FAIL draft" style="rounded=0;html=1;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="580" y="1490" width="400" height="36" as="geometry" />
        </mxCell>

        <!-- Condition note / AFV -->
        <mxCell id="s_cond" parent="1" value="&lt;b&gt;utils.py: add_condition_note(screen, row)&lt;/b&gt;  if aply_cond_nt=Y&lt;br/&gt;  send_pf(8) → place_value(&apos;910&apos;,2,37) → send_enter() → place_value(COND_NOTE, 7,6) → send_enter();  fail → FAIL draft&lt;br/&gt;&lt;b&gt;utils.py: update_condition_afv(screen, row)&lt;/b&gt;  if aply_cond_afv=Y&lt;br/&gt;  send_pf(8) → place_value(&apos;910&apos;,2,37) → send_enter() → place_value(AFV, 5,68) → send_enter();  fail → FAIL draft" style="rounded=1;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="420" y="1552" width="720" height="70" as="geometry" />
        </mxCell>

        <!-- CLAIM_TYPE split -->
        <mxCell id="d_clmtype" parent="1" value="CLAIM_TYPE?" style="rhombus;fillColor=#ffd600;strokeColor=#f9a825;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1">
          <mxGeometry x="695" y="1650" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- UB branch -->
        <mxCell id="ub_hdr" parent="1" value="UB  →  SCREEN: BLX2460.01" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="60" y="1754" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ub_body" parent="1" value="&lt;b&gt;updt_frm_to_dt=Y&lt;/b&gt;  (script.py)&lt;br/&gt;  Read FROM@(2,63), THRU@(2,75), SERV@(6,17)&lt;br/&gt;  FROM≠SERV → remove_value(2,63); place_value(SERV,2,63)&lt;br/&gt;  THRU≠SERV → remove_value(2,75); place_value(SERV,2,75)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;utils.py: apply_ineligibility_codes(&apos;UB&apos;, dny_by_cpt)&lt;/b&gt;&lt;br/&gt;  For rows 6-9: if CPT in dny_by_cpt → place inel_code @ ineligibility rows&lt;br/&gt;  → send_enter(); send_pf(8); place_value(&apos;460&apos;,2,37); send_enter()&lt;br/&gt;&lt;br/&gt;&lt;b&gt;chk_per_diem=Y:&lt;/b&gt;&lt;br/&gt;  &lt;font color=&quot;#ce93d8&quot;&gt;ub.py: ub_per_diem_process(screen, row, settings)&lt;/font&gt;&lt;br/&gt;  Fills CPS506: rls_code=60, pnd_rsn=O99, pnd_opid=CF10, note=PER DIEM LINE&lt;br/&gt;  STOP all remaining drafts → status: &apos;PER DIEM PROCESSED&apos;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;ub.py: ub_data_entry(screen, row, settings, codes, status_parts)&lt;/b&gt;&lt;br/&gt;  For rows 6-9: inel codes, AP codes, denial codes, modifier ops, BN codes…&lt;br/&gt;  Handles edit errors: 8803/8806, SP REQUIRED, duplicate inel, TOS edits&lt;br/&gt;  ub_tos_entry(), bypass_duplicate(), check_inel_code(), is_fully_paid()&lt;br/&gt;  res=0 → FAIL draft;  res=1 → continue" style="rounded=0;html=1;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="60" y="1778" width="380" height="290" as="geometry" />
        </mxCell>

        <!-- HCFA branch -->
        <mxCell id="hcfa_hdr" parent="1" value="HCFA  →  SCREEN: CPS450.01" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
          <mxGeometry x="1120" y="1754" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hcfa_body" parent="1" value="&lt;b&gt;utils.py: apply_ineligibility_codes(&apos;HCFA&apos;, dny_by_cpt)&lt;/b&gt;&lt;br/&gt;  For rows 5,7,9,11: if CPT in dny_by_cpt → place inel_code @ ineligibility rows&lt;br/&gt;  → send_enter(); send_pf(8); place_value(&apos;450&apos;,2,37); send_enter()&lt;br/&gt;&lt;br/&gt;&lt;b&gt;hcfa.py: hcfa_data_entry(screen, row, settings, codes, status_parts)&lt;/b&gt;&lt;br/&gt;  NEW_POS @ (2,6);  apply_uc=Y → &apos;X&apos; @ (29,69)&lt;br/&gt;  For service lines (rows 5,7,9,11):&lt;br/&gt;    inel codes, AP codes, denial codes, modifiers, BN codes&lt;br/&gt;    grid price check, DX codes, OI elig/pd, bond clinic…&lt;br/&gt;  After ENTER:&lt;br/&gt;    CPS445 dup screen → enter &amp; bypass or FAIL&lt;br/&gt;    Handles: BN edits, DX exceptions, TOS/POS errors&lt;br/&gt;    hcfa_tos_entry(), bypass_duplicate(), check_inel_code()&lt;br/&gt;    is_fully_paid(), total_amt_858(), plan_id_update()&lt;br/&gt;  res=0 → FAIL draft;  res=1 → continue" style="rounded=0;html=1;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontSize=10;align=left;" vertex="1">
          <mxGeometry x="1120" y="1778" width="380" height="290" as="geometry" />
        </mxCell>

        <!-- Invalid claim type -->
        <mxCell id="err_clmtype" parent="1" value="Other → INVALID CLAIM TYPE → FAIL draft" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
          <mxGeometry x="630" y="1754" width="300" height="34" as="geometry" />
        </mxCell>

        <!-- CPS506 shared outcome -->
        <mxCell id="cps506_hdr" parent="1" value="SCREEN: CPS506.01   (Release / Pend decision screen)   —   called from both ub_data_entry and hcfa_data_entry" style="rounded=0;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1">
