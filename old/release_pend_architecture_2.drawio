        </mxCell>
        <mxCell id="err_520" parent="1" value="screen.GetString(31,2,70) → read error msg&#xa;send_pf(9) → SKIP claim" style="rounded=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=10;" vertex="1">
