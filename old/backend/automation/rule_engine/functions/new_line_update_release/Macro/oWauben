Public Function RTN_OIPAID_AMT(ByRef tBilledLessMdPdB4Check As Double, ByRef tMdDedCoin As Double, _
ByRef PctChrg As Double, ByVal OiEligAmt As Double, ByVal i As Integer) As Double
    If i > 1 Then
        RTN_OIPAID_AMT = Round(OiEligAmt * PctChrg, 2)
    Else
        Select Case tBilledLessMdPdB4Check
            Case Is = tMdDedCoin: RTN_OIPAID_AMT = Round(OiEligAmt * PctChrg, 2)
            Case Is < tMdDedCoin: RTN_OIPAID_AMT = Round(OiEligAmt * PctChrg, 2) - (tMdDedCoin - tBilledLessMdPdB4Check)
            Case Is > tMdDedCoin: RTN_OIPAID_AMT = Round(OiEligAmt * PctChrg, 2) + (tBilledLessMdPdB4Check - tMdDedCoin)
        End Select
    End If
End Function

Public Function RTN_ELIG_AMT(ByVal ChrgAmt As String) As Double
    RTN_ELIG_AMT = 0
    If Len(Trim(ChrgAmt)) < 1 Then Exit Function
    RTN_ELIG_AMT = CDbl(ChrgAmt)
End Function

Public Sub MED_CALC_SETTINGS()
    Dim i As Integer
    MdCalc.RemoveAll
    With RF
        For i = 3 To .Cells(.Rows.Count, "D").End(xlUp).Row
            If Not MdCalc.Exists(Trim(.Range("D" & i))) Then _
            MdCalc.Add CStr(Trim(.Range("D" & i))), CStr(Trim(.Range("E" & i))) & ":" & CStr(Trim(.Range("F" & i))) & ":" & CStr(Trim(.Range("G" & i)))
        Next i
    End With
End Sub

Public Sub MRU_CALC_SETTINGS()
    Dim i As Integer
    MruCalc.RemoveAll: PosIn.RemoveAll
    With RF
        For i = 3 To .Cells(.Rows.Count, "J").End(xlUp).Row
            If Not MruCalc.Exists(CStr(Trim(.Range("J" & i)) & Trim(.Range("K" & i)))) Then _
            MruCalc.Add CStr(Trim(.Range("J" & i)) & Trim(.Range("K" & i))), CStr(Trim(.Range("L" & i))) & ":" & CStr(Trim(.Range("M" & i)))
        Next i
        For i = 3 To .Cells(.Rows.Count, "N").End(xlUp).Row
            If Not MruCalc.Exists(CStr(Trim(.Range("N" & i)))) Then _
            PosIn.Add CStr(Trim(.Range("N" & i))), CStr(Trim(.Range("N" & i)))
        Next i
    End With
End Sub

