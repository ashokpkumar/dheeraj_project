Public Function Place_EOB_Notes(ByVal SESSION_TYP As String, ByVal Note As String)
    Dim noteEntry As Variant, n As Integer, wordEntry As String, r As Integer
    If Len(Trim(Note)) < 1 Then Exit Function
    noteEntry = Split(Note, " "): r = 16
    For n = 0 To UBound(noteEntry)
        wordEntry = wordEntry & " " & noteEntry(n)
        If Len(wordEntry) > 43 Then
            wordEntry = Replace(wordEntry, noteEntry(n), "")
            PLACEVALUE SESSION_TYP, Trim(wordEntry), r, 36
            wordEntry = "": wordEntry = wordEntry & noteEntry(n)
            r = r + 1
        End If
    Next n
    If Len(Trim(wordEntry)) > 0 Then PLACEVALUE SESSION_TYP, Trim(wordEntry), r, 36
End Function

Public Function No_SVCLn_Update(ByVal SESSION_TYP As String, ByVal InelCode As String, ByVal rW As Long, ByVal ClaimType As String) As Boolean 'Added 2023.04.13
    Dim i As Integer, L As Integer, cntRead As Integer
    No_SVCLn_Update = True: cntRead = 0
    Select Case ClaimType
        Case "UB"
            For i = 6 To 9
                If Len(SCREEN_TEXT(SESSION_TYP, i, 3, 4)) < 1 Then Exit For
                If SCREEN_TEXT(SESSION_TYP, i + 6, 14, 4) <> InelCode Then No_SVCLn_Update = False
                cntRead = cntRead + 1
            Next i
        Case "HCFA"
            L = 9
            For i = 5 To 11 Step 2
                If Len(SCREEN_TEXT(SESSION_TYP, i, 4, 6)) < 1 Then Exit For
                If SCREEN_TEXT(SESSION_TYP, i + L, 14, 4) <> InelCode Then No_SVCLn_Update = False
                cntRead = cntRead + 1
            Next i
    End Select
    If cntRead < 1 Then No_SVCLn_Update = False
End Function

Public Function ClaimDraft_SVCLn_Update(ByVal SESSION_TYP As String, ByRef wS As Worksheet, ByVal ClaimType As String, ByVal rW As Long, ByVal ClaimNo As String) As Boolean
    Dim rNG As Range, Ln As Range, i As Integer, BgDt As String, Cpt As String, L As Integer, a As Integer, p As Integer
    Dim ChrgAmt As String, Units As String, Mod01 As String, Mod02 As String, AP As String, Mod03 As String
    ClaimDraft_SVCLn_Update = False
    If wS.AutoFilterMode Then wS.AutoFilterMode = False
    lRw = wS.Cells(wS.Rows.Count, colCCN2).End(xlUp).Row + 1 'ADJUSTED 2022.03.24
    wS.Range("G12:W" & lRw).AutoFilter Field:=1, Criteria1:=ClaimNo 'modified 2022.07.20
    If wS.AutoFilter.Range.Columns(colCCN2).SpecialCells(xlCellTypeVisible).Cells.Count - 1 > 0 Then
        Set rNG = wS.AutoFilter.Range.Columns(colCCN2).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible)
        wS.AutoFilter.Range.Columns(colStat).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible).ClearContents 'Ajustted 2024.06.14 - Clear Macro Status "AE"
        Select Case ClaimType
            Case "UB"
                If wS.OLEObjects("chkBp").Object.Value Then 'ADDED 2025.02.18
                    PLACEVALUE SESSION_TYP, "RP", 2, 5
                End If
                a = 0
                For i = 6 To 9
                    If Len(SCREEN_TEXT(SESSION_TYP, i, 3, 4)) < 1 Then Exit For
                   '====== ADDED 05.08.2023 ======
                    If wS.OLEObjects("chkFrmTo").Object.Value Then
                        FromDate = SCREEN_TEXT(SESSION_TYP, 2, 63, 6)
                        ThruDate = SCREEN_TEXT(SESSION_TYP, 2, 75, 6)
                        ServDate = SCREEN_TEXT(SESSION_TYP, 6, 17, 6)
                        If FromDate <> ServDate Then
                            PLACEVALUE SESSION_TYP, ServDate, 2, 63
                        End If
                        If ThruDate <> ServDate Then
                            PLACEVALUE SESSION_TYP, ServDate, 2, 75
                        End If
                    End If
                   '==============================
                    For Each Ln In rNG
                        If wS.Range("AA6") = "Y" Then 'ADDED 2026.06.17
                            If ExCDs.Exists(CStr(SCREEN_TEXT(SESSION_TYP, i + 6, 14, 4))) Then
                                ClaimDraft_SVCLn_Update = True
                                GoTo uNxtRw 'ADDED 2026.06.17
                            End If
                        End If
                        If UbCd.Exists(SCREEN_TEXT(SESSION_TYP, i + 6, 14, 4)) Then
                            BgDt = Format(Trim(wS.Range(colBgnSvDt & Ln.Row)), "MMDDYY")
                            Cpt = Trim(wS.Range(colCPT & Ln.Row))
                            Units = Format(Trim(wS.Range(colUnit & Ln.Row)), "000")
                            ChrgAmt = Format(Trim(wS.Range(colLnChgAmt & Ln.Row)), "#.00")
                            Mod01 = Trim(wS.Range(colMod1 & Ln.Row))
                            Mod02 = Trim(wS.Range(colMod2 & Ln.Row))
                            Mod03 = Trim(wS.Range(colMod3 & Ln.Row)) 'ADDED 2026.03.10
                            AP = Trim(wS.Range(colAP & Ln.Row)) 'Added 2022.07.20
                            If Len(wS.Range(colStat & Ln.Row)) > 0 Then GoTo uNxtRw 'ADDED 2023.08.01
                           'If Len(Trim(ws.Range(colStat & Ln.Row))) > 0 Then GoTo uNxtRw 'SKIP IF ALREADY HAS STATUS
                            If Len(BgDt) < 1 Or Len(ChrgAmt) < 1 Then GoTo uNxtRw
                            If IS_IT_MATCHING(BgDt, SCREEN_TEXT(SESSION_TYP, i, 17, 6)) <> True Then GoTo uNxtRw 'SERDT
                            If Len(Cpt) > 0 Then _
                            If IS_IT_MATCHING(Cpt, SCREEN_TEXT(SESSION_TYP, i, 8, 5)) <> True Then GoTo uNxtRw 'HCPCS ' 2023.07.27 FIXED
                            If Len(Units) > 0 Then _
                            If IS_IT_MATCHING(Units, Format(SCREEN_TEXT(SESSION_TYP, i, 32, 3), "000")) <> True Then GoTo uNxtRw 'BU 'Adjusted 2022.04.26 "000"
                            If IS_IT_MATCHING(ChrgAmt, SCREEN_TEXT(SESSION_TYP, i, 40, 11)) <> True Then GoTo uNxtRw 'CHARGE
                            If Len(Mod01) > 0 Then _
                            If IS_IT_MATCHING(Mod01, SCREEN_TEXT(SESSION_TYP, i, 52, 3)) <> True Then GoTo uNxtRw 'MOD 01
                            If Len(Mod02) > 0 Then _
