Public Sub SetInelCdList()
    Dim i As Integer
    HcfaCd.RemoveAll: UbCd.RemoveAll: ExCDs.RemoveAll
    With RF
        For i = 3 To .Cells(.Rows.Count, "A").End(xlUp).Row
            If Not HcfaCd.Exists(Trim(.Range("A" & i))) Then _
            HcfaCd.Add IIf(Trim(.Range("A" & i)) = "BLANK", "", CStr(Trim(.Range("A" & i)))), CStr(Trim(.Range("A" & i)))
        Next i
        For i = 3 To .Cells(.Rows.Count, "B").End(xlUp).Row
            If Not UbCd.Exists(Trim(.Range("B" & i))) Then _
            UbCd.Add IIf(Trim(.Range("B" & i)) = "BLANK", "", CStr(Trim(.Range("B" & i)))), CStr(Trim(.Range("B" & i)))
        Next i
        For i = 3 To .Cells(.Rows.Count, "P").End(xlUp).Row 'ADDED 2026.06.17
            If Not ExCDs.Exists(CStr(Trim(.Range("P" & i)))) Then _
            ExCDs.Add CStr(Trim(.Range("P" & i))), CStr(Trim(.Range("P" & i)))
        Next i
    End With
End Sub

Public Function OOP_Claim(ByVal ClaimNo As String) As Boolean
    Dim lRw As Long
    OOP_Claim = False
    With MN
        If .AutoFilterMode Then .AutoFilterMode = False
        lRw = .Cells(.Rows.Count, "G").End(xlUp).Row
       .Range("A12:W" & lRw).AutoFilter Field:=7, Criteria1:=ClaimNo
       .Range("A12:W" & lRw).AutoFilter Field:=14, Criteria1:="<0"
        If .AutoFilter.Range.Columns(1).SpecialCells(xlCellTypeVisible).Cells.Count - 1 > 0 Then
            OOP_Claim = True
        End If
        If .AutoFilterMode Then .AutoFilterMode = False
    End With
End Function

Public Sub Line_Update_Release(ByVal SESSION_TYP As String, ByVal rW As Long)
    Dim tDrafts As Integer, i As Integer, p As Integer, DraftNo As Integer, pgCur As Integer, msg As String
    If MN.AutoFilterMode Then MN.AutoFilterMode = False
    MN.Range("I1") = rW: SetInelCdList
    MN.Range(colDraft & rW & ":" & colExMsg & rW).ClearContents
EntryPoint:
    Select Case SCREEN_TEXT(SESSION_TYP, 1, 2, 10)
        Case "CPS520.01"
             MN.Range(colClmTyp & rW & ":" & colExMsg & rW).ClearContents
             SENDTHIS_KEY SESSION_TYP, "PF9"
             PLACEVALUE SESSION_TYP, Trim(MN.Range(colCCN1 & rW)), 8, 15
             SENDTHIS_KEY SESSION_TYP, "ENTER"
             If SCREEN_TEXT(SESSION_TYP, 1, 3, 10) <> "CPS520.01" Then
                tDrafts = 0
CountTotalDraft:
                For i = 6 To 19 Step 2
                    If Len(SCREEN_TEXT(SESSION_TYP, i, 2, 2)) < 1 Then Exit For
                    tDrafts = tDrafts + 1
                    DoEvents
                Next i
                If InStr(1, SCREEN_TEXT(SESSION_TYP, 20, 2, 60), "MORE DATA") > 0 Then
                    SENDTHIS_KEY SESSION_TYP, "PF11"
                    GoTo CountTotalDraft
                End If
             Else
                MN.Range(colExMsg & rW) = SCREEN_TEXT(SESSION_TYP, 31, 2, 60)
                GoTo NextRw
             End If
             MN.Range(colDraft & rW) = "'" & tDrafts
             SENDTHIS_KEY SESSION_TYP, "PF9"
             If OOP_Claim(Trim(MN.Range(colCCN1 & rW))) <> False Then
                MN.Range(colExMsg & rW) = "POSSIBLE OUT-OF-NETWORK CLAIM"
                GoTo NextRw
             End If
             DraftNo = 1: pgCur = 1
             For i = 1 To tDrafts
                SENDTHIS_KEY SESSION_TYP, "PF9"
                PLACEVALUE SESSION_TYP, Trim(MN.Range(colCCN1 & rW)), 8, 15
                SENDTHIS_KEY SESSION_TYP, "ENTER"
                If DraftNo > 7 Then
