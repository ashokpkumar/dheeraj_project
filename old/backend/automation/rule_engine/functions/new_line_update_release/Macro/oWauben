Public Sub MEDICARE_CALCULATION(ByRef wS As Worksheet, ByVal OiType As String, ByVal ClaimNo As String)
    Dim lRw As Long, rNG As Range, tBilled As Double, Ln As Range, PctChrg As Double, i As Integer
    Dim tMdDedCoin As Double, tMdPdB4Check As Double, tBilledLessMdPdB4Check As Double
    Dim tBilledLessNonCov As Double
    On Error GoTo ErrHandler
    MED_CALC_SETTINGS
    With wS 'MAIN SHEET
       '.Application.ScreenUpdating = False
        If .AutoFilterMode Then .AutoFilterMode = False
        lRw = .Cells(wS.Rows.Count, colCCN2).End(xlUp).Row
       .Range("A12:W" & lRw).AutoFilter Field:=.Columns(colCCN2).Column, Criteria1:=ClaimNo 'modified 2022.07.20
        If .AutoFilter.Range.Columns(1).SpecialCells(xlCellTypeVisible).Cells.Count - 1 > 0 Then
            Set rNG = .AutoFilter.Range.Columns(colCCN2).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible)
           .AutoFilter.Range.Columns(colOIEligAmt).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible).ClearContents 'U
           .AutoFilter.Range.Columns(colOIPdAmt).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible).ClearContents  'V
           .AutoFilter.Range.Columns(colOIType).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible).ClearContents 'W
            
            If Not MdCalc.Exists(ClaimNo) Then
               .AutoFilter.Range.Columns(colStat).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible) = "NO MED CALC SET."
                GoTo JustExit
            End If
            tBilled = .Application.WorksheetFunction.Subtotal(109, .Range(colLnChgAmt & "12:" & lRw))
            tBilledLessNonCov = tBilled - Split(MdCalc(ClaimNo), ":")(2)
            If tBilled <> tBilledLessNonCov Then
                MsgBox "Claim Control Number: " & ClaimNo & vbNewLine & _
                    "Total Billed DOES NOT EQUAL to Individual Services entered" & vbCrLf & _
                    "Review Line Charge Amount Entered" & vbCrLf & _
                    "Make sure the Non-Covered Charges were not entered" & vbNewLine & vbNewLine & _
                    "REMINDER: Do not include non-covered charges in Medicare Deductible and Coinsurance from EOB" & vbNewLine & vbNewLine & _
                    "See Medicare Calculation Worksheet for reference.", vbCritical, ThisWorkbook.Name
                    .AutoFilter.Range.Columns(colStat).Offset(1, 0).Resize(lRw - 12, 1).SpecialCells(xlCellTypeVisible) = "MED CALC AMT FAILED."
                GoTo JustExit
            End If
            tMdDedCoin = Format(Split(MdCalc(ClaimNo), ":")(0), "#.00")
            PctChrg = Round(1 - (tMdDedCoin / tBilledLessNonCov), 9)
            Select Case OiType
                Case "TYPE B"
                    For Each Ln In rNG
                       .Range(colOIEligAmt & Ln.Row) = RTN_ELIG_AMT(.Range(colLnChgAmt & Ln.Row))
                       'Debug.Print Round((.Range(colOIEligAmt & Ln.Row) * PctChrg), 2)
                        tMdPdB4Check = tMdPdB4Check + Round((.Range(colOIEligAmt & Ln.Row) * PctChrg), 2)
                    Next Ln
                    tBilledLessMdPdB4Check = tBilled - tMdPdB4Check: i = 1
                    For Each Ln In rNG
                       .Range(colOIPdAmt & Ln.Row) = Round(RTN_OIPAID_AMT(tBilledLessMdPdB4Check, tMdDedCoin, PctChrg, .Range(colOIEligAmt & Ln.Row), i), 2)
                        i = i + 1
                    Next Ln
            End Select
        End If
       '.Application.ScreenUpdating = True
       'MsgBox "Medicare " & OiType & " Calculation finished.", vbInformation, ThisWorkbook.Name
JustExit:
        If .AutoFilterMode Then .AutoFilterMode = False
        Exit Sub
ErrHandler:
        MsgBox Err.Description, vbCritical, "Unexpected error occured"
        If .AutoFilterMode Then .AutoFilterMode = False
       .Application.ScreenUpdating = True: End
       'GoTo JustExit
    End With
End Sub

