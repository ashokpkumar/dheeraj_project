Public Sub MACRO_LIST_AND_LOG_SETUP(ByVal IS_WEBCLAIM_REQUIRED As Boolean)
    Dim FileSYS As FileSystemObject: Set FileSYS = New FileSystemObject
    Local_Folder = Environ("LocalAppData") & "\Macros\VBS"
    CREATE_FOLDERS Local_Folder
    If FILE_MODDATE_COMPARE(dASSETFILE & fASSETLIST, Local_Folder & "\" & fASSETLIST) <> False Then _
    COPY_FILE dASSETFILE & fASSETLIST, Local_Folder & "\" & fASSETLIST
    EnvUSER = Left(UCase(Environ("SessionName")), 3)
    If EnvUSER <> "ICA" Then
        If IS_WEBCLAIM_REQUIRED <> False Then
            If Not FileSYS.FolderExists(Local_Folder & "\" & "Utilities") Then _
            FileSYS.CopyFolder dASSETFILE & "Utilities", Local_Folder & "\" & "Utilities"
            If FILE_EXISTS(Local_Folder & "\Utilities\PdfClaimImageDetails.dll") <> False Then _
            ADD_REFERENCE_LIBRARY Local_Folder & "\Utilities\PdfClaimImageDetails.tlb"
        End If
    End If
    SET_MACRO_FILE_PROPERTIES
    SETUP_USAGE_LOGGING 'AAI SCRIPT
    Set FileSYS = Nothing
End Sub

Public Sub SET_MACRO_FILE_PROPERTIES()
    With ThisWorkbook.BuiltinDocumentProperties
       .Item("Title") = mASSETNAME
       .Item("Keywords").Value = mDEPENDENCIES
       .Item("Comments").Value = mSPECIFICS
       .Item("Document version").Value = mCURRENTVR
       .Item("Category").Value = mCATEGORY
       .Item("Subject").Value = mSUBJECT
        If Len(Trim(.Item("Revision number").Value)) < 1 Then _
       .Item("Revision number").Value = 1 Else _
       .Item("Revision number").Value = CLng(.Item("Revision number").Value) + 1
    End With
End Sub

Private Sub AAI_ASSET_INI(ByVal pDIR As String, ByVal fNAME As String)
    Dim wSH As WshShell: Set wSH = New WshShell
    Open pDIR & "Schema.ini" For Output As #1
    Print #1, "[" & fNAME & "]"
    Print #1, "Format=TabDelimited"
    Print #1, "ColNameHeader=True"
    Print #1, "MaxScanRows=0"
    Close #1
    Set wSH = Nothing
End Sub

Public Function AAI_ASSET_INFO(ByVal pDIR As String, ByVal fNAME As String) As String
    Dim objCON As ADODB.Connection, oConSTR As String, objRS As ADODB.Recordset, QrySTR As String
    oConSTR = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" & pDIR & ";" & _
    "Extended Properties=" & """" & "Text;HDR=Yes;FMT=Delimited;ReadOnly=True" & """" & ";"
    AAI_ASSET_INFO = ""
    AAI_ASSET_INI pDIR, fNAME
    Set objCON = New ADODB.Connection
    If objCON.STATE = adStateClosed Then objCON.Open oConSTR
    QrySTR = "SELECT TOP 1 [ASSETID] FROM [" & fNAME & "] WHERE [ASSET NAME] = '" & mASSETNAME & _
    "' AND UCASE([ASSET STATUS]) = 'ACTIVE' ORDER BY CDATE([CREATIONDATE]) DESC;"
    Set objRS = New ADODB.Recordset
    objRS.Open QrySTR, objCON, adOpenKeyset, adLockReadOnly, adCmdText
    If Not objRS.EOF Then AAI_ASSET_INFO = objRS(0)
    If objRS.STATE Then objRS.Close
    If objCON.STATE = adStateOpen Then objCON.Close
    DEL_EXISTING_FILE Local_Folder & "\" & "Schema.ini"
End Function

Public Function DEL_EXISTING_FILE(ByVal KillFile As String) As String
     DEL_EXISTING_FILE = "NOT DELETED"
     If Len(Dir$(KillFile)) > 0 Then
         SetAttr KillFile, vbNormal: Kill KillFile
         DEL_EXISTING_FILE = "DELETED"
     End If
End Function

Public Sub CREATE_FOLDERS(ByVal FolderPATH As String) 'AAI SCRIPT
    Dim FileSYS As FileSystemObject, dFOLDERS As String, Folder
    Set FileSYS = New FileSystemObject
    For Each Folder In Split(FolderPATH, "\")
        dFOLDERS = dFOLDERS & Folder & "\"
        If Not FileSYS.FolderExists(dFOLDERS) Then
            On Error Resume Next
            FileSYS.CreateFolder dFOLDERS
        End If
    Next: Set FileSYS = Nothing
End Sub

Public Function FILE_MODDATE_COMPARE(ByVal origFILE As String, ByVal destFILE As String) As Boolean 'AAI SCRIPT
    Dim FileSYS As FileSystemObject
    FILE_MODDATE_COMPARE = False
    Set FileSYS = New FileSystemObject
    If (MODIFIED_FILE_CHECK(origFILE) <> MODIFIED_FILE_CHECK(destFILE)) Or _
    Not FileSYS.FileExists(destFILE) Then
        FILE_MODDATE_COMPARE = True
    End If
    Set FileSYS = Nothing
End Function

Public Function MODIFIED_FILE_CHECK(ByVal filePATH As String) As Date 'AAI SCRIPT
    Dim FileSYS As FileSystemObject, modFILE As File
    Set FileSYS = New FileSystemObject
    If FileSYS.FileExists(filePATH) Then
        Set modFILE = FileSYS.GetFile(filePATH)
        MODIFIED_FILE_CHECK = Trim(modFILE.DateLastModified)
    Else
        MODIFIED_FILE_CHECK = "1/1/1899"
    End If: Set FileSYS = Nothing: Set modFILE = Nothing
End Function

Public Sub COPY_FILE(ByVal origFILE As String, ByVal destFILE As String) 'AAI SCRIPT
    Dim FileSYS As FileSystemObject
    Set FileSYS = New FileSystemObject
    If FileSYS.FileExists(origFILE) Then
        On Error Resume Next
        FileSYS.CopyFile origFILE, destFILE, True
    End If: Set FileSYS = Nothing
End Sub

Public Function FILE_EXISTS(ByVal filePATH As String) As Boolean  'ADDED 2025.05.02
    Dim FileSYS As FileSystemObject
    Set FileSYS = New FileSystemObject
    FILE_EXISTS = False
    If FileSYS.FileExists(filePATH) Then FILE_EXISTS = True
    Set FileSYS = Nothing
End Function

